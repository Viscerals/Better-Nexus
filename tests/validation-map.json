{
  "schema": 1,
  "routes": [
    {
      "id": "community-startup-continuation",
      "patterns": ["^core/(CommunityController|MainLifecycle)\\.lua$", "^ui/CommunityBuilds\\.lua$", "^tests/(harness|run_community_startup_continuation)\\.lua$"],
      "groups": ["runtime", "performance", "catalog"],
      "tests": ["tests/run_community_startup_continuation.lua", "tests/run_main_lifecycle_parity.lua", "tests/run_main_contract_characterization.lua", "tests/run_community_builds.lua", "tests/run_integration.lua"],
      "full_required": true
    },
    {
      "id": "wishlist-native-confirmation-layer",
      "patterns": ["^ui/WishlistRenderer\\.lua$", "^tests/run_tome_and_popup_ui\\.lua$"],
      "groups": ["runtime", "ui"],
      "tests": ["tests/run_tome_and_popup_ui.lua", "tests/run_wishlist_editor.lua", "tests/run_wishlist_refresh_budget.lua"],
      "full_required": true
    },
    {
      "id": "bundled-catalog-retirement",
      "patterns": ["^data/BundledBuilds\\.lua$", "^tests/fixtures/.*", "^tests/run_bundled_catalog_retirement\\.lua$"],
      "groups": ["runtime", "catalog", "packaging"],
      "tests": ["tests/run_bundled_catalog_retirement.lua", "tests/run_bundled_build_export.lua", "tests/run_build_catalog_migration.lua", "tests/run_community_catalog_status.lua", "tests/run_startup_catalog_cost.lua", "tests/run_stage35_live_failure_characterization.lua"],
      "full_required": true
    },
    {
      "id": "pr58-authority-pair-repair",
      "patterns": [
        "^core/(CandidateEvidence|DataRetention|DpsCapture|ViewProjections)\\.lua$",
        "^ui/(CommunityRenderer|Leaderboard)\\.lua$",
        "^docs/MODULAR_REFACTOR_CHARACTERIZATION\\.md$",
        "^tests/run-pr58-expected-red\\.js$",
        "^tests/run_(pr58_authority_pair_repair|leaderboard_virtualization|recovered_build_navigation|stage32_leaderboard_locked_fidelity|live_projection_work_budget)\\.lua$"
      ],
      "groups": ["runtime", "performance", "dps", "leaderboard", "authority"],
      "tests": [
        "tests/run-pr58-expected-red.js",
        "tests/run_pr58_authority_pair_repair.lua",
        "tests/run_paired_dps_summary.lua",
        "tests/run_historical_locked_authority.lua",
        "tests/run_community_dps_eligibility.lua",
        "tests/run_locked_evidence_resolver.lua",
        "tests/run_data_retention.lua",
        "tests/run_view_projections.lua",
        "tests/run_live_projection_work_budget.lua",
        "tests/run_leaderboard_virtualization.lua",
        "tests/run_recovered_build_navigation.lua",
        "tests/run_stage32_leaderboard_locked_fidelity.lua",
        "tests/run_integration.lua"
      ],
      "full_required": true
    },
    {
      "id": "store-authority-kernel",
      "patterns": [
        "^core/(Store|MainLifecycle|LegacyDataMigration)\\.lua$",
        "^tests/(run_store_legacy_retirement|run_store_contract_characterization|run_store_additive_migrations|run_main_lifecycle_parity|run_main_contract_characterization|run_legacy_data_migration|run_conservative_account_identity|run_stage36_lifecycle_safety|run_module_contract_characterization)\\.lua$"
      ],
      "groups": [
        "authority",
        "runtime"
      ],
      "tests": [
        "tests/run_store_legacy_retirement.lua",
        "tests/run_store_contract_characterization.lua",
        "tests/run_store_additive_migrations.lua",
        "tests/run_main_lifecycle_parity.lua",
        "tests/run_main_contract_characterization.lua",
        "tests/run_legacy_data_migration.lua",
        "tests/run_conservative_account_identity.lua",
        "tests/run_stage36_lifecycle_safety.lua",
        "tests/run_module_contract_characterization.lua",
        "tests/run_catalog_authority_read_purity.lua",
        "tests/run_catalog_authority_bootstrap.lua"
      ],
      "full_required": true
    },
    {
      "id": "catalog-authority",
      "patterns": [
        "^core/(BuildCatalog|LoadoutEvidence|DataRetention|DataCompaction|BuildHashCache)\\.lua$",
        "^tests/(catalog_authority_support|run_catalog_authority_admission|run_catalog_authority_bootstrap|run_catalog_authority_commit_fault_matrix|run_catalog_authority_cursor_lifetime|run_catalog_authority_generation_exhaustion|run_catalog_authority_maintenance|run_catalog_authority_read_purity|run_catalog_authority_provenance|run_catalog_authority_tombstones|run_catalog_authority_semantic_union|run_catalog_authority_witness_drift|run_catalog_authority_work_budget|run_catalog_authority_unknown_fields|run_catalog_runtime_cutover|run_data_retention_detached_isolation|run_sync_semantic_envelope|run_typed_id_parity|run_sync_mixed_client_matrix)\\.lua$",
        "^tests/run-catalog-authority-expected-red\\.js$"
      ],
      "groups": ["authority", "runtime"],
      "tests": [
        "tests/run-catalog-authority-expected-red.js",
        "tests/run_catalog_authority_admission.lua",
        "tests/run_catalog_authority_semantic_union.lua",
        "tests/run_catalog_authority_bootstrap.lua",
        "tests/run_catalog_authority_commit_fault_matrix.lua",
        "tests/run_catalog_authority_cursor_lifetime.lua",
        "tests/run_catalog_authority_generation_exhaustion.lua",
        "tests/run_catalog_authority_tombstones.lua",
        "tests/run_catalog_authority_maintenance.lua",
        "tests/run_catalog_authority_provenance.lua",
        "tests/run_catalog_authority_read_purity.lua",
        "tests/run_catalog_authority_witness_drift.lua",
        "tests/run_catalog_authority_work_budget.lua",
        "tests/run_catalog_runtime_cutover.lua",
        "tests/run_sync_semantic_envelope.lua",
        "tests/run_sync_mixed_client_matrix.lua",
        "tests/run_build_catalog.lua",
        "tests/run_catalog_authority_unknown_fields.lua",
        "tests/run_build_catalog_migration.lua",
        "tests/run_data_retention.lua",
        "tests/run_data_compaction_migration.lua",
        "tests/run_data_retention_detached_isolation.lua",
        "tests/run_loadout_evidence.lua",
        "tests/run_typed_id_parity.lua",
        "tests/run_integration.lua"
      ],
      "full_required": true
    },
    {
      "id": "sync",
      "patterns": ["^core/Sync.*\\.lua$"],
      "groups": ["sync"],
      "tests": [
        "tests/run_sync_protocol_parity.lua",
        "tests/run_sync_transport_safety.lua",
        "tests/run_sync_inbound_parity.lua",
        "tests/run_sync_reconciler_parity.lua",
        "tests/run_sync_integration.lua",
        "tests/run_sync_hostile_fuzz.lua"
      ],
      "full_required": true
    },
    {
      "id": "dps",
      "patterns": ["^core/DpsCapture\\.lua$"],
      "groups": ["dps", "sync"],
      "tests": [
        "tests/run_dps_capture.lua",
        "tests/run_dps_boards.lua",
        "tests/run_dps_mesh_sync.lua",
        "tests/run_dps_fanout_bound.lua",
        "tests/run_sync_integration.lua"
      ],
      "full_required": true
    },
    {
      "id": "leaderboard",
      "patterns": ["^ui/Leaderboard\\.lua$"],
      "groups": ["leaderboard"],
      "tests": [
        "tests/run_leaderboard_class_presentation.lua",
        "tests/run_leaderboard_ui.lua",
        "tests/run_leaderboard_virtualization.lua",
        "tests/run_leaderboard_refresh_budget.lua"
      ],
      "full_required": true
    },
    {
      "id": "workflow",
      "patterns": ["^\\.github/"],
      "groups": ["workflow", "security"],
      "tests": ["tests/run-quality-workflow-policy.js"],
      "full_required": true
    },
    {
      "id": "tooling",
      "patterns": ["^tools/", "^tests/validation-map\\.json$", "^tests/run-(quality|security)-.*\\.js$", "^package(?:-lock)?\\.json$", "^\\.(pre-commit-config\\.yaml|luarc\\.json|luacheckrc|gitleaks\\.toml)$", "^(stylua\\.toml|PSScriptAnalyzerSettings\\.psd1)$"],
      "groups": ["tooling", "package", "security"],
      "tests": [
        "tests/run-quality-toolchain.js",
        "tests/run-bundled-build-export.js",
        "tests/run-savedvariables-analyzer.js",
        "tests/run-package-metadata.js",
        "tests/run-quality-gate-self-tests.js",
        "tests/run-security-policy.js"
      ],
      "full_required": true
    },
    {
      "id": "policy",
      "patterns": ["^(AGENTS|AI_POLICY|SECURITY|RELEASE_SECURITY|CONTRACTS|UPSTREAM)\\.md$", "^(LICENSE|NOTICE)(?:\\.md)?$", "^\\.vibe/"],
      "groups": ["policy", "security", "workflow", "package"],
      "tests": [
        "tests/run-quality-workflow-policy.js",
        "tests/run-package-metadata.js",
        "tests/run-security-policy.js"
      ],
      "full_required": true
    },
    {
      "id": "documentation",
      "patterns": ["^(README|CHANGELOG)\\.md$", "^docs/.*\\.md$"],
      "groups": ["documentation"],
      "tests": [],
      "full_required": false
    },
    {
      "id": "runtime",
      "patterns": ["^(core|logic|ui|data)/.*\\.lua$|^Nexus\\.toc$|^tests/run_.*\\.lua$"],
      "groups": ["runtime"],
      "tests": ["tests/run_integration.lua"],
      "full_required": true
    }
  ],
  "default": {
    "groups": ["repository"],
    "tests": ["tests/run_integration.lua"],
    "full_required": true
  }
}
